  "vars": {"STRIPE_TRIAL_DAYS":"14","AI_GUEST_DAILY_LIMIT":"1","AI_FREE_DAILY_LIMIT":"3","AI_PREMIUM_DAILY_LIMIT":"40","OPENAI_MODEL":"gpt-5.6-luna"},
  "observability": {"enabled": true},
  "env": {
