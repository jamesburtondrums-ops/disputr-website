{
  "name": "disputr-website",
  "main": "worker-fixed.js",
  "compatibility_date": "2026-09-08",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
