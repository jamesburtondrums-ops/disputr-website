{
  "name": "disputr-website",
  "main": "worker-fixed.js",
  "compatibility_date": "2026-09-08",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "disputr-db",
      "database_id": "73534e26-aa23-4c93-8cf1-531f76817ddb"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "OPENAI_MODEL": "gpt-5-mini"
  }
}
